{
  "sources": [
    {
      "name": "kaggle-bible",
      "transport": "kaggle",
      "format": "csv",
      "dataset_env": "KAGGLE_DATASET",
      "dataset": "oswinrh/bible",
      "filter_translations": true,
      "fields": { "book": "b", "chapter": "c", "verse": "v", "text": "t" },
      "options": { "key_file": "key_english.csv" },
      "translations": [
        { "name": "KJV", "file": "t_kjv.csv", "canon_tags": ["protestant", "catholic", "orthodox"] },
        { "name": "ASV", "file": "t_asv.csv", "canon_tags": ["protestant", "catholic", "orthodox"] },
        { "name": "BBE", "file": "t_bbe.csv", "canon_tags": ["protestant", "catholic", "orthodox"] },
        { "name": "DARBY", "file": "t_dby.csv", "canon_tags": ["protestant", "catholic", "orthodox"] },
        { "name": "WBT", "file": "t_wbt.csv", "canon_tags": ["protestant", "catholic", "orthodox"] },
        { "name": "WEB", "file": "t_web.csv", "canon_tags": ["protestant", "catholic", "orthodox"] },
        { "name": "YLT", "file": "t_ylt.csv", "canon_tags": ["protestant", "catholic", "orthodox"] }
      ]
    },
    {
      "name": "deutero-sample",
      "transport": "local",
      "format": "json",
      "filter_translations": false,
      "fields": { "book": "book", "chapter": "chapter", "verse": "verse", "text": "text" },
      "translations": [
        { "name": "DRA", "file": "sample/deutero_sample.json", "canon_tags": ["catholic", "orthodox"] }
      ]
    }
  ]
}
