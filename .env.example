# =============================================================================
# Phase 1 - Foundation & Infrastructure
# Copy to `.env` and adjust. `.env` is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend behaviour toggles
#   LLM_BACKEND   : mock  -> deterministic fake replies (Mac dev, no GPU)
#                   vllm  -> real Qwen2.5-VL via vLLM (EC2 GPU / prod)
#   IMAGE_BACKEND : mock  -> returns a placeholder image (Mac dev, no GPU)
#                   comfy -> real ComfyUI + Juggernaut (EC2 GPU / prod)
# -----------------------------------------------------------------------------
LLM_BACKEND=mock
IMAGE_BACKEND=mock
LOG_LEVEL=INFO
APP_ENV=dev

# -----------------------------------------------------------------------------
# Internal service URLs (Docker network DNS names). Override only if needed.
# -----------------------------------------------------------------------------
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
COMFYUI_BASE_URL=http://comfyui:8188
QDRANT_URL=http://qdrant:6333
MCP_SERVER_URL=http://mcp-server:8001/mcp
# Backend URL the MCP server calls for scripture_search (internal DNS name).
BACKEND_URL=http://backend:8080

# Request timeouts (seconds)
LLM_TIMEOUT=120
IMAGE_TIMEOUT=300

# -----------------------------------------------------------------------------
# Public host for browser access (EC2 / prod only)
#   dev : leave unset (startup prints localhost)
#   prod: auto-detected from EC2 metadata on ./startup.sh prod
#   override: EC2 public IP or domain, e.g. 54.123.45.67 or app.example.com
# Used for startup URL hints; NEXT_PUBLIC_API_URL is what the UI actually uses.
# -----------------------------------------------------------------------------
# PUBLIC_HOST=54.123.45.67

# -----------------------------------------------------------------------------
# UI -> backend URL (must be reachable from the browser)
#   dev : http://localhost:8080
#   prod: http://<ec2-public-ip-or-domain>:8080
# Baked into the UI image at build time — rebuild ui after changing this.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Host port mapping (left side of docker compose "ports"). Change to avoid
# clashes on the host. Container-internal ports are fixed.
# -----------------------------------------------------------------------------
UI_PORT=3000
BACKEND_PORT=8080
MCP_PORT=8001
VLLM_PORT=8000
COMFYUI_PORT=8188
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# -----------------------------------------------------------------------------
# GPU / model serving (prod / EC2 only)
# -----------------------------------------------------------------------------
# HuggingFace token, only needed if the model repo is gated.
HF_TOKEN=
# Fraction of GPU memory vLLM may use (0-1).
VLLM_GPU_MEMORY_UTILIZATION=0.85
# Max model context length served by vLLM.
VLLM_MAX_MODEL_LEN=8192

# =============================================================================
# Phase 4 - Image generation (ComfyUI + Juggernaut SDXL)
# =============================================================================
# Checkpoint filename under ${MODELS_DIR}/checkpoints/ (matches the workflow).
IMAGE_CHECKPOINT=juggernautXL.safetensors
# SDXL sampling parameters.
IMAGE_STEPS=30
IMAGE_CFG=6.5
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_SAMPLER=dpmpp_2m
IMAGE_SCHEDULER=karras
# Style wrapper applied to every prompt; {theme} is substituted with the request.
IMAGE_STYLE_TEMPLATE=reverent Christian fine-art illustration of {theme}, sacred, dignified, soft natural light, painterly, highly detailed, tasteful composition
# Negative prompt (what to avoid).
IMAGE_NEGATIVE_PROMPT=lowres, blurry, watermark, signature, text, deformed, extra limbs, nsfw, gore, hateful, offensive, mocking, blasphemous
# Refuse disallowed image requests (explicit/hateful/etc.).
IMAGE_SAFETY_ENABLED=true

# =============================================================================
# Phase 2 - Automation orchestrator (infrastructure/script/script.sh)
# =============================================================================
# Default deploy mode when none is passed to script.sh (dev | prod).
DEPLOY_MODE=dev
# How long (seconds) to wait for all services to become healthy, and poll gap.
HEALTH_TIMEOUT=600
HEALTH_INTERVAL=5
# Minimum free disk (GB) the preflight check requires before building.
DISK_MIN_GB=15
# Host directory mounted into ComfyUI for model weights.
MODELS_DIR=./models

# -----------------------------------------------------------------------------
# Model download (infrastructure/lib/models.sh). No weights are committed.
#   Juggernaut SDXL checkpoint: prefer HF repo+file; fall back to a direct URL.
# -----------------------------------------------------------------------------
JUGGERNAUT_HF_REPO=RunDiffusion/Juggernaut-XL-v9
JUGGERNAUT_HF_FILE=Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors
# Optional direct download URL (used only if the HF repo/file are blank).
JUGGERNAUT_URL=
# Local filename written under ${MODELS_DIR}/checkpoints/ (matches the workflow).
JUGGERNAUT_LOCAL_FILE=juggernautXL.safetensors
# Optional sha256 to verify the downloaded checkpoint (blank = skip check).
JUGGERNAUT_SHA256=
# Pre-pull the LLM weights into the hf_cache volume during `prod` startup.
PREPULL_LLM=true

# =============================================================================
# Phase 2 - RAG / Bible grounding
# =============================================================================
# Master switch for retrieval-augmented grounding + citations.
RAG_ENABLED=true
# Sentence-transformers model used for both ingestion and query embedding.
# Small + CPU-friendly so dev works on a Mac without a GPU.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Query-side instruction prefix (bge retrieval models expect one). Blank to disable.
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
# Qdrant collection that holds the verse embeddings.
QDRANT_COLLECTION=bible_verses
# Number of verses retrieved per query.
RAG_TOP_K=5
# Path (inside the ingest container) to the source manifest describing
# the typed sources (kaggle + local_json) and their canon tags.
BIBLE_SOURCES=/app/data/sources.json

# =============================================================================
# Phase 3 - Real dataset (Kaggle) + anti-hallucination verification
# =============================================================================
# Kaggle dataset slug and which translations to embed (comma-separated).
# More translations = longer CPU ingestion; KJV alone keeps dev fast.
KAGGLE_DATASET=oswinrh/bible
INGEST_TRANSLATIONS=KJV
# Kaggle credentials for kagglehub. Leave blank to fall back to the bundled
# sample corpus. NEVER commit real values - .env is gitignored.
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=

# Verse verification (anti-hallucination).
VERIFY_ENABLED=true
# Translation whose canonical text is the source of truth for verification.
VERIFY_TRANSLATION=KJV
# difflib ratio below which a quoted verse is flagged as a misquote (0-1).
VERIFY_FUZZY_THRESHOLD=0.6

# =============================================================================
# Phase 5 - Conversational core (tone, memory, denomination framing)
# =============================================================================
# Sampling temperature for chat (lower = steadier, more consistent tone).
LLM_TEMPERATURE=0.4
# Image prompt composer LLM temperature (scene rewrite before ComfyUI render).
IMAGE_COMPOSER_TEMPERATURE=0.3
# Overridable persona the system prompt is built around.
LLM_PERSONA=You are a Christianity-focused assistant. You are pastoral, humble, and non-dogmatic, speaking with warmth and care.
# Server-side conversation memory keyed by session_id.
MEMORY_ENABLED=true
# Recent turns kept verbatim in the prompt (one turn = user + assistant).
MEMORY_MAX_TURNS=8
# When stored turns exceed this, the oldest fold into a running summary.
MEMORY_SUMMARY_THRESHOLD=12

# =============================================================================
# Phase 6 - Safety & moderation
# =============================================================================
# Master switch for input/output moderation.
MODERATION_ENABLED=true
# Optional Qwen-as-judge second opinion on borderline input (needs LLM_BACKEND=vllm).
MODERATION_LLM_JUDGE=false
# On-brand refusal message returned when a request is blocked.
MODERATION_REFUSAL=I'm sorry, but I can't help with that. I'm here to support you with Scripture, faith, and Christian life in a respectful way. If there's something along those lines I can help with, I'd be glad to.

# =============================================================================
# Phase 7 - Intent orchestrator + prompt composer
# =============================================================================
# Master switch for intent routing (normal skips RAG; scripture grounds; image composes).
ORCHESTRATOR_ENABLED=true
# Deprecated: vLLM planner runs automatically when LLM_BACKEND=vllm.
ORCHESTRATOR_LLM_INTENT=false
# Planner system prompt (vLLM returns JSON route + reason).
PLANNER_INSTRUCTION=You are the routing planner for a Christianity-focused assistant. Classify the user message into exactly one route: normal (not Christianity-related), scripture (Bible/faith/God — information, not a picture), or image (see/show/visualize/create/draw/generate a picture). Reply with ONLY valid JSON: {"route":"normal|scripture|image","reason":"brief explanation"}
# Minimum Qdrant score to accept a retrieved verse (0-1).
RAG_MIN_SCORE=0.35
# Reply when scripture route finds no grounded passages (no hallucination).
RAG_MISS_REPLY=I couldn't find enough grounded Scripture in my corpus to answer that confidently. I'd rather not guess — could you rephrase or ask about a specific passage?
# System prompt the image prompt-composer uses to turn a request into a scene.
IMAGE_COMPOSER_INSTRUCTION=You are an art director for reverent Christian fine art. Rewrite the user's request into one plain, visual sentence describing what appears in the picture (subject, setting, mood). Keep it concrete and dignified. Do not cite books, chapters, or verses. Avoid text/words in the image. Never depict anything explicit, violent, or mocking. Reply with only the scene description.
# User-facing reply while ComfyUI renders ({scene} = composed scene description).
IMAGE_REPLY_TEMPLATE=I'm creating a reverent Christian artwork for you: {scene}. Please wait a moment — your image will appear below shortly.

# =============================================================================
# Phase 8 - SSE streaming + context window
# =============================================================================
# Recent turns sent to the model per request (rolling summary covers older ones).
CONTEXT_RECENT_TURNS=3

# =============================================================================
# Phase 9 - Durable chat store (Postgres) + image-file persistence
# =============================================================================
# Postgres service credentials (consumed by the postgres container).
POSTGRES_USER=christai
POSTGRES_PASSWORD=christai
POSTGRES_DB=christai
POSTGRES_PORT=5432
# Master switch; when false the backend uses in-process memory only.
CHAT_STORE_ENABLED=true
# SQLAlchemy async URL the backend connects with.
DATABASE_URL=postgresql+asyncpg://christai:christai@postgres:5432/christai
# Where rendered PNGs are stored and the URL path they are served under.
MEDIA_DIR=/data/media
MEDIA_URL_PATH=/media
